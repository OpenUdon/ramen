{
  "version": "ramen.cloudflare.provider-parity.v1",
  "lane": "C03",
  "status": "planned",
  "provider": {
    "source": "cloudflare/cloudflare",
    "version_constraint": "~> 5.0"
  },
  "openapi": {
    "source_path": "testdata/api-sources/cloudflare-r2-d1-openapi.json",
    "fixture": "focused Cloudflare R2/D1 OpenAPI subset"
  },
  "safety": {
    "live_env": "RAMEN_CLOUDFLARE_PARITY",
    "record_update_env": "RAMEN_CLOUDFLARE_PARITY_RECORD_UPDATE",
    "lane_env": "RAMEN_CLOUDFLARE_PARITY_LANE",
    "opentofu_env": "RAMEN_CLOUDFLARE_TOFU",
    "terraform_env": "RAMEN_CLOUDFLARE_TERRAFORM",
    "account_env": "CLOUDFLARE_ACCOUNT_ID",
    "credential_binding": "cloudflare_api_token",
    "credential_env": "UDON_CREDENTIAL_CLOUDFLARE_API_TOKEN",
    "resource_prefix": "ramen-parity-c03-",
    "requires_explicit_lane": true,
    "live_enabled": false,
    "cleanup_fallback": "Cloudflare API DELETE /accounts/{account_id}/r2/buckets/{bucket_name}",
    "required_env": [
      "RAMEN_CLOUDFLARE_TOFU",
      "RAMEN_CLOUDFLARE_TERRAFORM",
      "CLOUDFLARE_ACCOUNT_ID",
      "CLOUDFLARE_API_TOKEN",
      "UDON_CREDENTIAL_CLOUDFLARE_API_TOKEN"
    ],
    "cost_guardrails": [
      "static first",
      "no live Cloudflare mutation",
      "cleanup verification before recording"
    ],
    "promotion": "C03 remains static until C01 confirms exact API-visible R2 metadata fields."
  },
  "recording": {
    "status": "static-only",
    "artifact_path": "testdata/parity/cloudflare/c03/live.observations.json",
    "update_env": "RAMEN_CLOUDFLARE_PARITY_RECORD_UPDATE"
  },
  "promotion": {
    "next": "Promote after C01 proves R2 lifecycle and metadata mutability is reviewed.",
    "live_candidate": false,
    "blockers": [
      "R2 metadata field casing and create-only/updateable behavior need live C01 evidence"
    ]
  },
  "runtimes": [
    "opentofu",
    "terraform",
    "ramen"
  ],
  "scenarios": [
    {
      "name": "r2 bucket metadata variants",
      "resource_type": "cloudflare_r2_bucket",
      "terraform_resource_type": "cloudflare_r2_bucket",
      "fixture_paths": [
        "testdata/parity/cloudflare/c03/hcl/main.tf",
        "testdata/parity/cloudflare/c03/ramen/project.uws.yaml",
        "testdata/api-sources/cloudflare-r2-d1-openapi.json"
      ],
      "operation_ids": [
        "r2-create-bucket",
        "r2-get-bucket",
        "r2-patch-bucket",
        "r2-delete-bucket"
      ],
      "observed_fields": [
        "location",
        "jurisdiction",
        "storage_class"
      ],
      "expected_transitions": [
        "static-create",
        "static-read",
        "static-update",
        "static-delete"
      ]
    }
  ],
  "notes": [
    "C03 is intentionally static-first because Cloudflare R2 metadata semantics need live C01 review before broader claims."
  ]
}
