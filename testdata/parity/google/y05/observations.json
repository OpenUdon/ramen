{
  "version": "ramen.google.provider-parity.v1",
  "lane": "Y05",
  "status": "planned",
  "provider": {
    "source": "hashicorp/google",
    "version_constraint": "~> 6.0"
  },
  "discovery": {
    "source_path": "../apitools/catalog-openapi-cache/google-discovery/google-cloud-storage-discovery-v1.json",
    "fixture": "testdata/parity/google/y05/ramen/project.uws.yaml"
  },
  "safety": {
    "live_env": "RAMEN_GOOGLE_PARITY",
    "record_update_env": "RAMEN_GOOGLE_PARITY_RECORD_UPDATE",
    "lane_env": "RAMEN_GOOGLE_PARITY_LANE",
    "opentofu_env": "RAMEN_GOOGLE_TOFU",
    "credential_binding": "google_oauth2",
    "resource_prefix": "ramen-parity-y05-",
    "requires_explicit_lane": true,
    "live_enabled": true,
    "cleanup_fallback": "gcloud storage rm --recursive gs://<ramen-parity-y05-*> --quiet, then gcloud storage buckets describe gs://<name> to verify absence",
    "required_env": [
      "RAMEN_GOOGLE_TOFU",
      "GOOGLE_APPLICATION_CREDENTIALS",
      "RAMEN_GOOGLE_PROJECT"
    ],
    "cost_guardrails": [
      "one disposable support bucket per runtime",
      "tiny non-secret object content",
      "no object content in observations"
    ],
    "promotion": "live object metadata lane enabled behind googlelive and explicit environment gates after Discovery upload endpoint support"
  },
  "runtimes": [
    "opentofu",
    "ramen"
  ],
  "scenarios": [
    {
      "name": "storage_object_metadata_static",
      "resource_type": "google_storage_bucket_object",
      "terraform_resource_type": "google_storage_bucket_object",
      "fixture_paths": [
        "testdata/parity/google/y05/hcl/main.tf",
        "testdata/parity/google/y05/ramen/project.uws.yaml"
      ],
      "operation_ids": [
        "storage.objects.insert",
        "storage.objects.get",
        "storage.objects.patch",
        "storage.objects.delete"
      ],
      "observed_fields": [
        "name",
        "bucket",
        "id",
        "generation",
        "size",
        "metadata.ramen_parity_phase"
      ],
      "expected_transitions": [
        "static-create-plan",
        "static-read-plan",
        "static-update-plan",
        "static-delete-plan",
        "opentofu-live-create-delete-smoked",
        "opt-in-ramen-udon-live-run"
      ]
    }
  ],
  "notes": [
    "Y05 adds Google Cloud Storage object metadata coverage.",
    "The HCL fixture uses a tiny non-secret literal only so tfconfig can parse a valid google_storage_bucket_object resource.",
    "Native and observation metadata intentionally exclude object payload bytes.",
    "Live execution creates one tiny object in a disposable support bucket per runtime and deletes the object plus bucket before recording."
  ]
}
