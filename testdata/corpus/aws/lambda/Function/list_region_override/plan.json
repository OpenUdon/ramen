{
  "version": "ramen.tfconvert.plan.v1",
  "workflow": "terraform_conversion_draft",
  "action": "create",
  "steps": [
    {
      "address": "aws_iam_role.test",
      "kind": "resource",
      "type": "aws_iam_role",
      "purpose": "create",
      "action": "create",
      "source_kind": "aws-smithy",
      "source_id": "iam",
      "source_path": "aws-smithy/iam.json",
      "operation_id": "CreateRole",
      "identity_attributes": [
        {
          "name": "role_name",
          "terraform_path": "name",
          "request_keys": [
            "RoleName"
          ],
          "response_paths": [
            "Role.RoleName",
            "Role.Arn"
          ],
          "required": true
        }
      ],
      "credentials": [
        "aws_hmac"
      ]
    },
    {
      "address": "aws_iam_role_policy.test",
      "kind": "resource",
      "type": "aws_iam_role_policy",
      "purpose": "create",
      "action": "create",
      "source_kind": "aws-smithy",
      "source_id": "iam",
      "source_path": "aws-smithy/iam.json",
      "operation_id": "PutRolePolicy",
      "credentials": [
        "aws_hmac"
      ]
    },
    {
      "address": "aws_lambda_function.test",
      "kind": "resource",
      "type": "aws_lambda_function",
      "purpose": "create",
      "action": "create",
      "source_kind": "aws-smithy",
      "source_id": "lambda",
      "source_path": "aws-smithy/lambda.json",
      "operation_id": "CreateFunction",
      "credentials": [
        "aws_hmac"
      ]
    }
  ]
