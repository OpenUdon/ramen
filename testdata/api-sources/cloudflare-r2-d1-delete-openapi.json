            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "cf-r2-jurisdiction",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "name"
                ],
                "properties": {
                  "name": {
                    "type": "string"
                  },
                  "locationHint": {
                    "type": "string"
                  },
                  "storageClass": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Created bucket"
          }
        },
        "security": [
          {
            "api_token": []
          }
        ]
      }
    },
